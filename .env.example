# AI features: keyword extraction, AI-refined journal ranking, conference web search,
# manuscript analysis and submission answers. Never use NEXT_PUBLIC_ prefix for secret keys.
# Recommended: a free Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Alternative provider (paid). Used only when GEMINI_API_KEY is empty (no web search).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# AI is public, limited per visitor per hour (one search uses about 3 units). Default 30.
AI_REQUESTS_PER_HOUR=30
# Recommended: a free OpenAlex key (https://openalex.org/settings/api). Without one, all visitors
# share a small daily budget per server IP; each journal search makes about 5 requests.
OPENALEX_API_KEY=
# Web search for the Impact Factor lookup and for workshops / calls for papers. Add any of these
# free keys; the site uses them in this order and switches when one runs out. One account per service.
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=
# AI fallbacks used in order when Gemini hits its limit (free keys: console.groq.com, openrouter.ai).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: Scopus CiteScore and SNIP. Free key from https://dev.elsevier.com (non-commercial use).
ELSEVIER_API_KEY=
# Optional: path to the SCImago CSV used for Q1-Q4 quartiles (default: data/scimago.csv).
SCIMAGO_CSV_PATH=
# Optional: configure your public email address for the About page.
NEXT_PUBLIC_CONTACT_EMAIL=
