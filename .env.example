# Optional: enables advanced Claude-powered manuscript analysis and submission answers.
# Never use NEXT_PUBLIC_ prefix for secret keys.
ANTHROPIC_API_KEY=
# Change to a model available on your Anthropic account if necessary.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Required for paid Claude features: choose a private random 16+ character access code.
# Without this setting, Claude requests are intentionally disabled even if a Claude key exists.
CLAUDE_ACCESS_CODE=
# Optional: use your OpenAlex API key for increased rate limits.
OPENALEX_API_KEY=
# Optional: configure your public email address for the About page.
NEXT_PUBLIC_CONTACT_EMAIL=
